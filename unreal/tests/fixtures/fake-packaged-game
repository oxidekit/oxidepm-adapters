#!/bin/sh
# Fake packaged game binary fixture for tests.
# See unreal/tests/fixtures/README.md for environment knobs.
set -eu

mode="${FAKE_MODE:-success}"
exit_code="${FAKE_EXIT_CODE:-1}"
mutex_hash="${FAKE_MUTEX_HASH:-0123456789abcdef0123456789abcdef01234567}"
delay="${FAKE_DELAY_SECONDS:-0}"
project="${FAKE_PROJECT:-SampleGame}"
engine_version="${FAKE_ENGINE_VERSION:-5.5.0}"
marker="${FAKE_MARKER:-FIXTURE_MARKER: PASS}"
log_file=""

if [ -n "${FAKE_ARGS_LOG:-}" ]; then
    {
        printf 'fake-packaged-game'
        for arg in "$@"; do
            printf '\t%s' "$arg"
        done
        printf '\n'
    } >> "$FAKE_ARGS_LOG"
fi

for arg in "$@"; do
    case "$arg" in
        -log=*) log_file="${arg#-log=}" ;;
        -abslog=*) log_file="${arg#-abslog=}" ;;
    esac
done

emit_line() {
    printf '%s\n' "$1"
    if [ -n "$log_file" ]; then
        printf '%s\n' "$1" >> "$log_file"
    fi
}

if [ -n "$log_file" ]; then
    mkdir -p "$(dirname "$log_file")"
    : > "$log_file"
fi

if [ "$delay" != "0" ] && [ -n "$delay" ]; then
    sleep "$delay"
fi

case "$mode" in
    success)
        emit_line "LogInit: Running DelayedAutoRegister Phase StartOfEnginePreInit"
        emit_line "LogCsvProfiler: Display: Metadata set : platform=\"Linux\""
        emit_line "LogCsvProfiler: Display: Metadata set : config=\"Development\""
        emit_line "LogCsvProfiler: Display: Metadata set : enginereleaseversion=\"${engine_version}\""
        emit_line "LogGame: Display: Booted ${project}"
        emit_line "${marker}"
        if [ -n "${FAKE_FORBIDDEN_MARKER:-}" ]; then
            emit_line "${FAKE_FORBIDDEN_MARKER}"
        fi
        emit_line "LogExit: Preparing to exit."
        emit_line "LogExit: Game engine shut down"
        emit_line "LogExit: Exiting."
        exit 0
        ;;
    nonzero)
        emit_line "LogInit: Running DelayedAutoRegister Phase StartOfEnginePreInit"
        emit_line "LogGame: Error: Fatal assertion failed during startup"
        emit_line "Exiting abnormally (error code: ${exit_code})"
        exit "$exit_code"
        ;;
    conflict)
        emit_line "A conflicting instance of Global\\UnrealBuildTool_Mutex_${mutex_hash} is already running."
        exit 10
        ;;
    hang)
        emit_line "LogInit: Running DelayedAutoRegister Phase StartOfEnginePreInit"
        emit_line "LogGame: Display: Booted ${project}"
        emit_line "FAKE_HANG_READY"
        exec sleep "${FAKE_HANG_SECONDS:-300}"
        ;;
    missing-marker)
        emit_line "LogInit: Running DelayedAutoRegister Phase StartOfEnginePreInit"
        emit_line "LogCsvProfiler: Display: Metadata set : platform=\"Linux\""
        emit_line "LogGame: Display: Booted ${project}"
        emit_line "LogExit: Preparing to exit."
        emit_line "LogExit: Game engine shut down"
        emit_line "LogExit: Exiting."
        exit 0
        ;;
    *)
        printf 'fake-packaged-game: unknown FAKE_MODE: %s\n' "$mode" >&2
        exit 2
        ;;
esac
