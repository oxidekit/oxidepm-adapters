{
  "schema": 1,
  "name": "runtime-node",
  "version": "0.4.0-rc.1",
  "kind": "tool",
  "summary": "Run Node.js, npm, pnpm and yarn apps.",
  "description": "Provides the node, npm, pnpm and yarn runtimes. It tells OxidePM what to run for an app, and OxidePM runs it; this adapter starts nothing, reads none of your files and has no network.",
  "tags": ["runtime"],
  "protocol": [1],
  "min_daemon": "0.1.0",
  "exec": "oxidepm-runtime-node",
  "provides": {
    "runtimes": ["node", "npm", "pnpm", "yarn"],
    "programs": ["node", "npm", "pnpm", "yarn"],
    "capture_programs": [],
    "env_set": []
  },
  "permissions": {
    "host": {"level": "read", "scope": "all"},
    "events": [],
    "env_pass": [],
    "network": {"mode": "none"},
    "fs": {"read": ["$STATE"], "write": []},
    "spawn": {"mode": "none"},
    "memory_mb": 64,
    "requires_enforcement": ["network"]
  }
}
